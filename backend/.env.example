# Base de datos PostgreSQL
DB_USER=postgres
DB_PASSWORD=admin
DB_HOST=localhost
DB_PORT=5432
DB_NAME=asier_futbol

# Servidor
PORT=5000
NODE_ENV=development

# Stripe (obtén en https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_tu_clave_secreta_aqui
STRIPE_PUBLIC_KEY=pk_test_tu_clave_publica_aqui
STRIPE_WEBHOOK_SECRET=whsec_tu_webhook_secret_aqui

# CORS
CORS_ORIGIN=http://localhost:3000

# JWT Secret (para autenticación)
JWT_SECRET=tu_clave_secreta_muy_segura_2024

# Emails con Brevo (https://app.brevo.com > SMTP & API > API Keys)
# Sin BREVO_API_KEY los emails se muestran en la consola del backend en lugar de enviarse.
BREVO_API_KEY=
# Debe ser un remitente verificado en Brevo (Senders, Domains & Dedicated IPs > Senders)
EMAIL_REMITENTE=tu_email@ejemplo.com
EMAIL_REMITENTE_NOMBRE=PakSports
# URL del frontend, usada en los enlaces de los emails
FRONTEND_URL=http://localhost:3000

# Usuario administrador (se crea con: npm run crear-admin)
ADMIN_EMAIL=admin@paksports.com
ADMIN_PASSWORD=tu_contraseña_admin
